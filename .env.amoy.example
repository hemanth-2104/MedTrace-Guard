# Copy to .env.amoy.local, which is ignored by Git. Restrict it: chmod 600 .env.amoy.local
# Enter secrets in your local editor only; never share a seed phrase or key in chat.
# This configuration is separate from the local .env and Vite .env.local.
AMOY_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com
AMOY_CHAIN_ID=80002
AMOY_CONFIRMATIONS=2
AMOY_RPC_TIMEOUT_MS=12000
AMOY_MIN_BALANCE_POL=0.1
# Optional CLI signing only: five dedicated funded accounts. Leave blank for MetaMask/browser use.
AMOY_ADMIN_PRIVATE_KEY=
AMOY_MANUFACTURER_PRIVATE_KEY=
AMOY_DISTRIBUTOR_PRIVATE_KEY=
AMOY_PHARMACY_PRIVATE_KEY=
AMOY_REGULATOR_PRIVATE_KEY=
# Exact bytes and actual URI from the IPFS upload/verification command.
AMOY_CERTIFICATE_FILE=evidence/ipfs/certificate-original.json
AMOY_CERTIFICATE_URI=ipfs://bafkreibu5ifryw6stuqi7uoddntloolf3rf7zb5aalzctnac5qou47rsei

# Public browser settings for npm run dev:amoy / build:amoy. Never put keys here.
VITE_DEPLOYMENT_PATH=/deployment.amoy.json
VITE_READ_RPC=https://polygon-amoy-bor-rpc.publicnode.com
VITE_IPFS_GATEWAY=https://gateway.pinata.cloud
